# pnpm 10 reads its settings here. pnpm 12.4.2 was seen to ignore them in this file, so a move to a later major
# must carry all three into pnpm-workspace.yaml.
side-effects-cache=false
ignore-scripts=false
# Minutes (three days). Resolution skips versions published more recently, direct and transitive, so a release
# that is pulled back within days never reaches the lockfile. A frozen install does not resolve and is unaffected.
# For a fix that cannot wait, pass --config.minimum-release-age=0 on that one command.
minimum-release-age=4320
