{
  "name": "risuai",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.34.1",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --sourcemap && node util/compressDist.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p server/tsconfig.json",
    "check:tests": "node util/testInventory.mjs",
    "check:docs": "node util/docsBudget.mjs --report",
    "test": "vitest run --tags-filter=!slow",
    "test:agent": "node util/agentTest.mjs",
    "test:overload": "node util/overloadTest.mjs",
    "test:slow": "vitest run --tags-filter=slow",
    "test:all": "vitest run",
    "test:e2e": "node util/requireHuman.mjs \"pnpm test:e2e\" && playwright test",
    "server": "node server/src/main.ts",
    "dev:agent": "node util/agentDev.mjs agent",
    "dev:human": "node util/agentDev.mjs human",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
