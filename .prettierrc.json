{
  "tabWidth": 4,
  "printWidth": 120,
  "semi": true,
  "singleQuote": false,
  "plugins": ["prettier-plugin-svelte"],
  "overrides": [
    {
      "files": ["*.json", "*.jsonc", "*.yml", "*.yaml", "*.md"],
      "options": { "tabWidth": 2 }
    },
    {
      "files": ["STRUCTURE.md", "docs/structure/**/*.md"],
      "options": { "proseWrap": "always" }
    }
  ]
}
